# Server-only Qloo credentials. Use the host your key issuer authorizes.
QLOO_API_KEY=
QLOO_BASE_URL=https://api.qloo.com

# Optional generative preference extraction. Otherwise explicitly labeled rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_PROVIDER=gemini

# Fictional fixtures are an opt-in UI preview, never a fallback for Qloo failures.
ALLOW_FIXTURE_DEMO=true

# Optional canonical HTTPS host for public deployment; blank uses same-origin URL.
APP_ORIGIN=
